# Data files (Keep directory structure via .gitkeep, ignore large datasets)
data/raw/*
!data/raw/.gitkeep
# Frozen OSM snapshot + audit metadata (shared so all roles use identical OSM data)
!data/raw/osm_facilities_current.json
!data/raw/osm_ingestion_metadata.json
!data/raw/osm_landmark_audit.json
!data/raw/jogjapulse_verification_summary.json
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep

# Synthetic development layers (tests/make_sample_*.py). Invented numbers:
# they prove the pipeline runs and must never reach the report.
data/_sample/

